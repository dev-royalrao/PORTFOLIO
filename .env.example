# Copy this file to `.env` and fill in the values, then restart `npm run dev`.
#
# NOTE: Vite inlines every VITE_* var into the built JavaScript. Treat this as
# public config, NOT a secret store. Never put an API key, a database URL or a
# private token here — a visitor can read it in the browser.

# --- Identity -----------------------------------------------------------
VITE_NAME=""
VITE_INITIALS=""
VITE_ROLE=""
VITE_HEADLINE=""
VITE_LOCATION=""

# --- Contact ------------------------------------------------------------
VITE_EMAIL=""
VITE_GITHUB=""
VITE_LINKEDIN=""

# Optional. Leave blank to hide the phone link entirely (current default).
VITE_PHONE=""

# --- Services -----------------------------------------------------------
# Your Calendly / Cal.com booking link. Blank hides the "Schedule a call" buttons.
VITE_SCHEDULE_URL=""

# Contact form POST URL. Blank makes the form tell visitors to email you.
# Either a Google Apps Script web-app /exec URL (see scripts/contact-form.gs)
# or a Formspree endpoint such as https://formspree.io/f/xxxxxxx
VITE_FORM_ENDPOINT=""

# --- Assets -------------------------------------------------------------
# Files live in public/ and are referenced with a leading ./
VITE_RESUME_URL=""
VITE_PHOTO_URL=""

# Intro video. Blank shows the photo with a "coming soon" caption.
# Drop the file in public/ and set this to ./intro.mp4 when ready.
VITE_VIDEO_URL=""
